# YouTube bot-check bypass: a Netscape cookies.txt from a throwaway Google account,
# exported after signing in to YouTube in a private window, then base64-encoded.
# Leave empty to test the no-cookies path first.
YOUTUBE_COOKIES=

# Optional HTTP/SOCKS proxy (http://user:pass@host:port), e.g. a residential proxy,
# if cookies alone don't get past the bot check from this host's IP.
YOUTUBE_PROXY=

# Download/encode jobs that may run at once in this process.
MEDIA_JOBS=2

# GPU video encoding for the watermark overlay. "off" is safest on an unknown host;
# "auto" tries hardware encoders and falls back to the CPU on failure either way.
VIDEO_HWACCEL=off

# Render sets this itself; only needed locally if you want a non-default port.
PORT=8000
