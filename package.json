{
  "name": "yt-downloader-poc",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"pnpm dev:api\" \"pnpm dev:web\"",
    "dev:web": "pnpm --filter web dev",
    "dev:api": "cd apps/api && uv run uvicorn app.main:app --reload --port 8010",
    "build:web": "pnpm --filter web build"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
